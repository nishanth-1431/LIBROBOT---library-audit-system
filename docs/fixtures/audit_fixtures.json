{
  "description": "Characterization test fixtures captured from legacy Libro-Bot classification behavior (legacy/backend/app.py:build_status)",
  "reference_database": "legacy/data/books_database_sample.xlsx",
  "sample_books": [
    {
      "barcode": "LIB-1001",
      "name": "Python for Robotics",
      "author": "John Doe",
      "department": "Computer Science",
      "status": "Available",
      "shelf": "C1"
    },
    {
      "barcode": "LIB-1002",
      "name": "Linear Algebra",
      "author": "Gilbert Strang",
      "department": "Mathematics",
      "status": "Available",
      "shelf": "H1"
    },
    {
      "barcode": "LIB-1003",
      "name": "Circuit Analysis",
      "author": "Hayt & Kemmerly",
      "department": "Electronics",
      "status": "Available",
      "shelf": "F1"
    },
    {
      "barcode": "LIB-1004",
      "name": "Machine Learning",
      "author": "Andrew Ng",
      "department": "Computer Science",
      "status": "Available",
      "shelf": "C1"
    },
    {
      "barcode": "LIB-1005",
      "name": "Data Structures",
      "author": "Mark Allen Weiss",
      "department": "Computer Science",
      "status": "Available",
      "shelf": "C1"
    }
  ],
  "test_scenarios": [
    {
      "scenario_id": "PERFECT_SHELF_AUDIT_C1",
      "description": "Audit targeting shelf C1 where all registered C1 books are scanned. Books on H1 and F1 are ignored.",
      "input": {
        "target_shelf": "C1",
        "scanned_barcodes": ["LIB-1001", "LIB-1004", "LIB-1005"]
      },
      "expected_output": {
        "available_barcodes": ["LIB-1001", "LIB-1004", "LIB-1005"],
        "missing_barcodes": [],
        "safely_issued_barcodes": [],
        "misplaced_barcodes": []
      }
    },
    {
      "scenario_id": "SHELF_AUDIT_WITH_MISPLACED_AND_MISSING",
      "description": "Audit targeting shelf C1. LIB-1004 and LIB-1005 are missing. LIB-1003 (from F1) is misplaced here. UNKNOWN-999 is an uncataloged item found here.",
      "input": {
        "target_shelf": "C1",
        "scanned_barcodes": ["LIB-1001", "LIB-1003", "UNKNOWN-999"]
      },
      "expected_output": {
        "available_barcodes": ["LIB-1001"],
        "missing_barcodes": ["LIB-1004", "LIB-1005"],
        "safely_issued_barcodes": [],
        "misplaced": [
          {
            "barcode": "LIB-1003",
            "registered_shelf": "F1",
            "found_on_shelf": "C1"
          },
          {
            "barcode": "UNKNOWN-999",
            "registered_shelf": "Unknown",
            "found_on_shelf": "C1"
          }
        ]
      }
    },
    {
      "scenario_id": "FULL_LIBRARY_AUDIT_WITH_ISSUED_BOOK",
      "description": "Whole-library audit (target_shelf is null). LIB-1002 is marked Issued in DB. Only LIB-1001 and LIB-1003 are scanned.",
      "input": {
        "target_shelf": null,
        "database_overrides": {
          "LIB-1002": { "status": "Issued" }
        },
        "scanned_barcodes": ["LIB-1001", "LIB-1003"]
      },
      "expected_output": {
        "available_barcodes": ["LIB-1001", "LIB-1003"],
        "safely_issued_barcodes": ["LIB-1002"],
        "missing_barcodes": ["LIB-1004", "LIB-1005"],
        "misplaced_barcodes": []
      }
    }
  ]
}
