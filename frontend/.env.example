# Firebase Authentication & Services (Client-side Web SDK)
# Obtain these from your Firebase Console -> Project Settings -> General -> Web App
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Backend Service URLs
VITE_CORE_API_URL=http://localhost:8080
VITE_VISION_SERVICE_URL=http://localhost:8000

# Dev/Demo Login Bypass (INSECURE - strictly for local development and offline demo)
# Set to 'true' to allow bypassing Firebase Auth locally with dev credentials
VITE_ENABLE_DEV_LOGIN=false
VITE_DEV_ADMIN_EMAIL=admin@librobot.com
VITE_DEV_ADMIN_PASSWORD=admin123
