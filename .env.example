# ========================================================
# Libro-Bot Root Environment Variables Template
# Copy this file to .env for local development
# NEVER commit real credentials to GitHub
# ========================================================

# Database (MySQL 8) Configuration
MYSQL_ROOT_PASSWORD=your_root_password_here
DB_NAME=librobot_db
DB_USER=librobot
DB_PASSWORD=your_secure_db_password_here
DB_HOST=localhost
DB_PORT=3306

# Test Database Configuration
TEST_DB_NAME=librobot_test_db

# Spring Boot Core Platform Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Vision Service Configuration (FastAPI)
VISION_SERVICE_PORT=8000
